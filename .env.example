# App
NODE_ENV=development
PORT=4000
BASE_URL=https://yourdomain.com

# MongoDB (MongoDB Atlas connection string - include DB name)
MONGO_URI=mongodb+srv://<user>:<pass>@cluster0.mongodb.net/tesla_quantum?retryWrites=true&w=majority

# JWT / Auth
JWT_SECRET=change_this_to_a_strong_random_secret
JWT_EXPIRY=7d
BCRYPT_SALT_ROUNDS=12

# TOTP
TOTP_ISSUER=TeslaQuantumAI

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=supersecret

# Redis (caching)
REDIS_URL=redis://:password@redis-host:6379/0

# Third-party market data
COINGECKO_API_URL=https://api.coingecko.com/api/v3
ALPHA_VANTAGE_KEY=YOUR_ALPHA_VANTAGE_KEY
OPENEXCHANGE_API_KEY=YOUR_OPENEXCHANGE_KEY

# Broker placeholders (sandbox)
BINANCE_API_KEY=YOUR_BINANCE_KEY
BINANCE_API_SECRET=YOUR_BINANCE_SECRET
ALPACA_API_KEY=YOUR_ALPACA_KEY
ALPACA_API_SECRET=YOUR_ALPACA_API_SECRET

# PM2 / Monitoring
PM2_LOG_DIR=/var/log/tesla-quantum